# If VTE runs in Docker (e.g. docker-compose) behind this host Nginx, set
# TRUSTED_PROXIES=127.0.0.1,::1,172.16.0.0/12 for VTE so X-Forwarded-For is
# trusted and login rate limiting / logs see the real client IP.
# Place inside the existing HTTPS server block managed by Certbot.
# Change proxy_pass if you publish VTE on a different local port.
location / {
    proxy_pass http://127.0.0.1:8050;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    client_max_body_size 128m;
    proxy_buffering off;
    proxy_read_timeout 900s;
    proxy_send_timeout 900s;
}
